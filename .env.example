# Same-server MySQL connection. Use a database account granted SELECT only.
MYSQL_HOST=127.0.0.1
# Valid range: 1-65535.
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
# Operational range: 1-20.
MYSQL_CONNECTION_LIMIT=5

# Local development only: expose the remote MySQL server on a local port with
# `npm run db:tunnel`. The managed database listens on loopback, so the tunnel is
# required from a workstation. Leave MYSQL_HOST/MYSQL_PORT pointing at the tunnel
# endpoint (127.0.0.1:3306) while the tunnel runs.
SSH_TUNNEL_HOST=
SSH_TUNNEL_PORT=22
SSH_TUNNEL_USER=
SSH_TUNNEL_PASSWORD=
SSH_TUNNEL_REMOTE_HOST=127.0.0.1
SSH_TUNNEL_REMOTE_PORT=3306
SSH_TUNNEL_LOCAL_HOST=127.0.0.1
SSH_TUNNEL_LOCAL_PORT=3306
