{
  "name": "jianshi-research-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "db:audit": "node --conditions=react-server --import tsx scripts/audit-mysql-schema.mjs",
    "db:tunnel": "node --env-file=.env scripts/db-tunnel.mjs",
    "strategy:dry-run": "node --import tsx scripts/run-momentum-strategy.mjs",
    "test": "npm run test:unit && npm run build && node --test tests/rendered-html.test.mjs",
    "test:unit": "node --import tsx --test tests/ipo-render.test.tsx tests/ipo-adapters.test.mjs tests/momentum-strategy.test.mjs tests/motion-model.test.mjs tests/mysql-boundary.test.mjs tests/orbit-model.test.mjs tests/prototype-*.test.mjs tests/research-request-gate.test.mjs tests/research-repositories.test.mjs tests/research-routes.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .codex_tmp"
  },
  "dependencies": {
    "lucide-react": "1.28.0",
    "mysql2": "3.23.3",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "ssh2": "1.17.0",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  },
  "type": "module"
}
